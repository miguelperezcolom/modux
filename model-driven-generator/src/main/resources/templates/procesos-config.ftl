# Configuration of the workflow engine (EventConductor's orchestrator), generated by Modux from the
# model's workflows. Mounted at /config and read on top of the image's own application.yaml.
workflow:
  events:
    # every event a workflow starts on or waits for, on the topic its service publishes it to
    destinations:
<#list destinations as d>
      ${d.name}:
        topic: ${d.topic}
</#list>
    consumer:
      group: ${project.name?lower_case?replace("[^a-z0-9]","-",'r')}-procesos
  http:
    # the services whose use cases the steps run: as the system identity (role SISTEMA)
    connections:
<#list connections as c>
      ${c.name}:
        base-url: ${r"${"}${c.envName}:${c.url}${r"}"}
        auth: sistema
</#list>
    auth:
      sistema:
        type: basic
        username: ${project.systemUser!"sistema"}
        password: ${r"${"}MODUX_SYSTEM_PASSWORD${r"}"}
