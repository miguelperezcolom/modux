<#assign uiEs = ((project.defaultLocale!"")?has_content?then(project.defaultLocale!"", (project.locales![])?has_content?then((project.locales![""])[0], "")))?lower_case?starts_with("es")>
# API gateway — <#if uiEs>las rutas salen del modelo (servicios + uiAdapters); GENERADO por modux.<#else>the routes come from the model (services + uiAdapters); GENERATED by modux.</#if>
server:
    port: ${gatewayPort?c}

spring:
    application:
        name: ${project.name?lower_case?replace("[^a-z0-9]","-",'r')}-api-gateway
    cloud:
        gateway:
            server:
                webmvc:
                    # each target comes from {SERVICE}_URL / SHELL_URL (containers, Kubernetes);
                    # the default is the host-run one up.sh starts
                    routes:
<#list services as s>
                    # ${s.name}: <#if uiEs>frontera de máquinas (REST de los gateways ACL)<#else>machine border (REST of the ACL gateways)</#if>
                    - id: api-${s.slug}
                      uri: ${r"${"}${s.slug?upper_case?replace("-","_")}_URL:http://localhost:${s.port?c}}
                      predicates: [ "Path=/api/${s.slug}/**" ]
                      filters: [ "StripPrefix=2" ]
</#list>
<#list apps as a>
<#if uiEs>
                    # ${a.slug}: micro-frontend (rutas /_app de la shell) y caminos de máquina
                    # en ruta natural (los sync del micro-frontend van a /<app>/mateu y /<app>/assets);
                    # la UI en /<app> la sirve la shell, que monta la app dentro (misma sesión)
<#else>
                    # ${a.slug}: micro-frontend (the shell's /_app routes) and machine paths
                    # on the natural route (the micro-frontend syncs go to /<app>/mateu and /<app>/assets);
                    # the UI at /<app> is served by the shell, which mounts the app inside (same session)
</#if>
                    - id: mateu-${a.slug}
                      uri: ${r"${"}${a.svc?upper_case?replace("-","_")}_URL:http://localhost:${a.port?c}}
                      predicates: [ "Path=/_${a.slug}/mateu/**" ]
                      filters: [ "RewritePath=/_${a.slug}/mateu(?<segment>/?.*), /${a.slug}/mateu${r"${segment}"}" ]
                    - id: ui-${a.slug}
                      uri: ${r"${"}${a.svc?upper_case?replace("-","_")}_URL:http://localhost:${a.port?c}}
                      predicates: [ "Path=/_${a.slug}/**" ]
                      filters: [ "RewritePath=/_${a.slug}(?<segment>/?.*), /${a.slug}${r"${segment}"}" ]
                    - id: app-${a.slug}
                      uri: ${r"${"}${a.svc?upper_case?replace("-","_")}_URL:http://localhost:${a.port?c}}
                      predicates: [ "Path=/${a.slug}/mateu/**, /${a.slug}/assets/**" ]
</#list>
<#list proxies![] as px>
                    # proxy ${px.name}: <#if uiEs>la API que publica ${px.svc}, para fuera<#if (px.ttl > 0)>, con caché de ${px.ttl?c} s (ProxyCacheFilter)</#if><#else>the API ${px.svc} publishes, for the outside<#if (px.ttl > 0)>, cached for ${px.ttl?c} s (ProxyCacheFilter)</#if></#if>
                    - id: proxy-${px.slug}
                      uri: ${r"${"}${px.svc?upper_case?replace("-","_")}_URL:http://localhost:${px.port?c}}
                      predicates: [ "Path=${px.path}/**" ]
                      filters: [ "StripPrefix=${px.segments?c}" ]
</#list>
<#if forms!false>
<#if uiEs>
                    # las tareas de las personas (la app de formularios de EventConductor), en /_forms:
                    # IdentityBridge le pasa quién ha entrado (la cookie del sistema, verificada)
<#else>
                    # people's tasks (EventConductor's forms app), at /_forms:
                    # IdentityBridge tells it who signed in (the system's cookie, verified)
</#if>
                    - id: forms
                      uri: ${r"${"}FORMS_URL:http://localhost:8106}
                      predicates: [ "Path=/_forms/**" ]
</#if>
                    # <#if uiEs>la shell (todo lo demás)<#else>the shell (everything else)</#if>
                    - id: shell
                      uri: ${r"${"}SHELL_URL:http://localhost:${shellPort?c}}
                      predicates: [ "Path=/**" ]
