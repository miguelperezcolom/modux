package ${securityPackage};

import jakarta.servlet.FilterChain;
import jakarta.servlet.ServletException;
import jakarta.servlet.http.Cookie;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.time.Duration;
import java.util.Arrays;
import java.util.Base64;
import java.util.stream.Collectors;
import javax.crypto.Mac;
import javax.crypto.spec.SecretKeySpec;
import org.springframework.core.env.Environment;
import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
import org.springframework.security.core.Authentication;
import org.springframework.security.core.GrantedAuthority;
import org.springframework.security.core.authority.SimpleGrantedAuthority;
import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.security.web.authentication.AuthenticationSuccessHandler;
import org.springframework.web.filter.GenericFilterBean;

/**
 * One login for the whole system when the model has roles but no identity provider: the form
 * login of the shell (or of any service) leaves a signed cookie with the user and their roles, and
 * every service of the system accepts it. They all sit behind the same front door (the gateway, one
 * origin) and share the secret ({@code MODUX_AUTH_SECRET}), so the cookie travels with every call
 * of the shell's micro-frontends. Generated by modux; replace with an identity provider in the
 * model for real users.
 */
public final class ModuxAuthCookie extends GenericFilterBean {

    static final String NAME = "MODUX_AUTH";
    static final String DEV_SECRET = "modux-dev-secret-change-me";
    static final Duration LIFETIME = Duration.ofHours(8);

    private final byte[] secret;

    ModuxAuthCookie(String secret) {
        this.secret = secret.getBytes(StandardCharsets.UTF_8);
    }

    static ModuxAuthCookie from(Environment env) {
        return new ModuxAuthCookie(env.getProperty("MODUX_AUTH_SECRET", DEV_SECRET));
    }

    /** Signs the user in for every service: the cookie, then where the form login goes next. */
    AuthenticationSuccessHandler loginSuccess(String target) {
        return (request, response, authentication) -> {
            issue(response, authentication);
            response.sendRedirect(target);
        };
    }

    void issue(HttpServletResponse response, Authentication authentication) {
        var roles = authentication.getAuthorities().stream().map(GrantedAuthority::getAuthority)
                .collect(Collectors.joining(","));
        var expires = System.currentTimeMillis() + LIFETIME.toMillis();
        var payload = encode(authentication.getName() + "|" + roles + "|" + expires);
        response.addCookie(cookie(payload + "." + sign(payload), (int) LIFETIME.toSeconds()));
    }

    static void clear(HttpServletResponse response) {
        response.addCookie(cookie("", 0));
    }

    /** On every dispatch, not once per request: a forward re-reads the security context and would lose it. */
    @Override
    public void doFilter(jakarta.servlet.ServletRequest req, jakarta.servlet.ServletResponse res, FilterChain chain)
            throws ServletException, IOException {
        var request = (HttpServletRequest) req;
        var response = (HttpServletResponse) res;
        var current = SecurityContextHolder.getContext().getAuthentication();
        if (current == null || !current.isAuthenticated() || "anonymousUser".equals(current.getPrincipal())) {
            var value = request.getCookies() == null ? null : Arrays.stream(request.getCookies())
                    .filter(c -> NAME.equals(c.getName())).map(Cookie::getValue).findFirst().orElse(null);
            var authentication = value == null ? null : verify(value);
            if (authentication != null) {
                var context = SecurityContextHolder.createEmptyContext();
                context.setAuthentication(authentication);
                SecurityContextHolder.setContext(context);
            }
        }
        chain.doFilter(request, response);
    }

    /** The user the cookie names, if it is ours (signature) and alive (expiry); null otherwise. */
    Authentication verify(String value) {
        var dot = value.lastIndexOf('.');
        if (dot < 0) return null;
        var payload = value.substring(0, dot);
        if (!MessageDigest.isEqual(sign(payload).getBytes(StandardCharsets.UTF_8),
                value.substring(dot + 1).getBytes(StandardCharsets.UTF_8))) return null;
        String[] parts;
        try {
            parts = new String(Base64.getUrlDecoder().decode(payload), StandardCharsets.UTF_8).split("\\|", -1);
        } catch (IllegalArgumentException e) {
            return null;
        }
        try {
            if (parts.length != 3 || Long.parseLong(parts[2]) < System.currentTimeMillis()) return null;
        } catch (NumberFormatException e) {
            return null;
        }
        var authorities = Arrays.stream(parts[1].split(",")).filter(r -> !r.isBlank())
                .map(SimpleGrantedAuthority::new).toList();
        return UsernamePasswordAuthenticationToken.authenticated(parts[0], null, authorities);
    }

    private String sign(String payload) {
        try {
            var mac = Mac.getInstance("HmacSHA256");
            mac.init(new SecretKeySpec(secret, "HmacSHA256"));
            return Base64.getUrlEncoder().withoutPadding().encodeToString(mac.doFinal(payload.getBytes(StandardCharsets.UTF_8)));
        } catch (java.security.GeneralSecurityException e) {
            throw new IllegalStateException(e);
        }
    }

    private static String encode(String text) {
        return Base64.getUrlEncoder().withoutPadding().encodeToString(text.getBytes(StandardCharsets.UTF_8));
    }

    private static Cookie cookie(String value, int maxAge) {
        var cookie = new Cookie(NAME, value);
        cookie.setPath("/");
        cookie.setHttpOnly(true);
        cookie.setMaxAge(maxAge);
        cookie.setAttribute("SameSite", "Lax");
        return cookie;
    }
}
