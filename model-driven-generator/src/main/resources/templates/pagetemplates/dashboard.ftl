<#include "common.ftl">
<#include "markdown-table.ftl">
<#assign ucSlug = usecase.name?lower_case?replace("[^a-z0-9]","",'r')>
<#assign ucClass = usecase.className>
<#assign tf = template.fields>
<#assign outFields = (outputModel.fields)![]>
<#function rendered f><#return (f.stereotype!"") == "html" || (f.stereotype!"") == "richText" || (f.stereotype!"") == "markdown"></#function>
<#function isList f><#return !(f.basicType?? && f.basicType) && (f.type!"") == "array" && f.modelId?? && template.rowModels[f.modelId]??></#function>
<#function isNumber f><#return (f.basicType?? && f.basicType) && ["integer", "number", "money"]?seq_contains(f.type!"")></#function>
<#function labelOf f><#return ((f.label?? && f.label?has_content)?then(f.label, f.name?cap_first))?j_string></#function>
package ${project.packageName}.${module.slug}.infra.in.ui.pages.${ucSlug};

import com.fasterxml.jackson.databind.ObjectMapper;
import io.mateu.core.infra.declarative.orchestrators.dashboard.Dashboard;
import io.mateu.uidl.annotations.Panel;
import io.mateu.uidl.annotations.Title;
import io.mateu.uidl.data.Chart;
import io.mateu.uidl.data.ChartData;
import io.mateu.uidl.data.ChartDataset;
import io.mateu.uidl.data.ChartType;
import io.mateu.uidl.data.Element;
import io.mateu.uidl.data.Markdown;
import io.mateu.uidl.data.MetricCard;
import io.mateu.uidl.fluent.Component;
import io.mateu.uidl.interfaces.HttpRequest;
import ${project.packageName}.${module.slug}.application.usecases.${ucSlug}.${ucClass}Command;
import ${project.packageName}.${module.slug}.application.usecases.${ucSlug}.${ucClass}Result;
import ${project.packageName}.${module.slug}.application.usecases.${ucSlug}.${ucClass}UseCase;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import lombok.SneakyThrows;
import org.springframework.context.annotation.Scope;
import org.springframework.stereotype.Service;

/**
 * ${usecase.title!ucClass}: Mateu's dashboard template — the use case's numbers as a band of KPIs,
 * its contents and lists as tiles. Generated by modux from the use case's pageTemplate.
 */
@Service
@Scope("prototype")
@Title("${(usecase.title!ucClass)?j_string}")
public class ${ucClass}Page extends Dashboard {

<#list outFields as f>
<#if isNumber(f)>
    MetricCard ${f.name};
</#if>
</#list>
<#list outFields as f>
<#if rendered(f)>

    @Panel(title = "${labelOf(f)}", colSpan = 2)
    Component ${f.name}Panel;
<#elseif isList(f)>
<#if tf.chartLabel?? && tf.chartValue?? && (tf.items!"") == f.name>

    @Panel(title = "${labelOf(f)}")
    Chart ${f.name}Chart;
</#if>

    @Panel(title = "${labelOf(f)}", colSpan = 2)
    Markdown ${f.name}Panel;
</#if>
</#list>

    private final transient ${ucClass}UseCase useCase;
    private final transient ObjectMapper objectMapper;
    private transient boolean loaded;

    public ${ucClass}Page(${ucClass}UseCase useCase, ObjectMapper objectMapper) {
        this.useCase = useCase;
        this.objectMapper = objectMapper;
    }

    @SneakyThrows
    void load() {
        ${ucClass}Result result = useCase.handle(new ${ucClass}Command(${commandArgs("-")}));
<#list outFields as f>
<#if isNumber(f)>
        ${f.name} = MetricCard.builder().title("${labelOf(f)}")
                .value(result.${f.name}() != null ? String.valueOf(result.${f.name}()) : "—").build();
<#elseif rendered(f)>
<#if f.stereotype == "markdown">
        ${f.name}Panel = new Markdown(result.${f.name}() != null ? result.${f.name}() : "", null, null);
<#else>
        ${f.name}Panel = Element.builder().name("div").attributes(Map.of()).on(Map.of())
                .content(result.${f.name}() != null ? result.${f.name}() : "").style("").cssClasses("").html(true).build();
</#if>
<#elseif isList(f)>
        ${f.name}Panel = new Markdown(tableOf(objectMapper, result.${f.name}(), ${columnsOf(template.rowModels[f.modelId])}), null, null);
<#if tf.chartLabel?? && tf.chartValue?? && (tf.items!"") == f.name>
        ${f.name}Chart = chartOf(result.${f.name}());
</#if>
</#if>
</#list>
        loaded = true;
    }

    @Override
    public Component component(HttpRequest httpRequest) {
        if (!loaded) load();
        return super.component(httpRequest);
    }
<#if tf.chartLabel?? && tf.chartValue??>

    /** The ${tf.items!"items"} as a bar chart: ${tf.chartLabel} on the axis, ${tf.chartValue} as the bar. */
    @SneakyThrows
    private Chart chartOf(String json) {
        List<Map<String, Object>> rows = json == null || json.isBlank() ? List.of()
                : objectMapper.readValue(json, objectMapper.getTypeFactory().constructCollectionType(List.class, Map.class));
        var labels = new ArrayList<String>();
        var values = new ArrayList<Double>();
        for (var row : rows) {
            labels.add(String.valueOf(row.get("${tf.chartLabel}")));
            var value = row.get("${tf.chartValue}");
            values.add(value instanceof Number n ? n.doubleValue() : value == null ? 0d : Double.parseDouble(String.valueOf(value)));
        }
        return Chart.builder().chartType(ChartType.${tf.chartType!"bar"})
                .chartData(ChartData.builder().labels(labels)
                        .datasets(List.of(ChartDataset.builder().label("${tf.chartValue}").data(values).build())).build())
                .build();
    }
</#if>

<@markdownTableHelper/>
}
