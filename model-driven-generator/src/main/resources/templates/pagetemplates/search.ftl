<#include "common.ftl">
<#assign ucSlug = usecase.name?lower_case?replace("[^a-z0-9]","",'r')>
<#assign ucClass = usecase.className>
<#assign tf = template.fields>
<#assign rowFields = (template.rowModels[template.itemsModelId].fields)![]>
package ${project.packageName}.${module.slug}.infra.in.ui.pages.${ucSlug};

import com.fasterxml.jackson.databind.ObjectMapper;
import io.mateu.core.infra.declarative.orchestrators.smartsearch.SmartSearchPage;
import io.mateu.uidl.annotations.Label;
import io.mateu.uidl.annotations.Title;
import io.mateu.uidl.annotations.Trigger;
import io.mateu.uidl.annotations.TriggerType;
import io.mateu.uidl.data.ListingData;
import io.mateu.uidl.data.SearchRequest;
import io.mateu.uidl.interfaces.HttpRequest;
<#if template.item??>
import io.mateu.uidl.interfaces.Navigable;
</#if>
import ${project.packageName}.${module.slug}.application.usecases.${ucSlug}.${ucClass}Command;
import ${project.packageName}.${module.slug}.application.usecases.${ucSlug}.${ucClass}UseCase;
import java.util.ArrayList;
import java.util.List;
import lombok.RequiredArgsConstructor;
import lombok.SneakyThrows;
import org.springframework.context.annotation.Scope;
import org.springframework.stereotype.Service;

/**
 * ${usecase.title!ucClass}: Mateu's smart search template — the use case's input as the search
 * facets, its ${template.itemsField} as the results<#if template.item??>; a row opens ${template.item.className}</#if>.
 * Generated by modux from the use case's pageTemplate.
 */
@Service
@Scope("prototype")
@RequiredArgsConstructor
@Title("${(usecase.title!ucClass)?j_string}")
@Trigger(type = TriggerType.OnLoad, actionId = "search")
public class ${ucClass}Page extends SmartSearchPage<${ucClass}Page.Filtros, ${template.rowClass}><#if template.item??>
        implements Navigable<${template.item.pageFqn}, String></#if> {

    /** The search facets: the use case's input. */
    public static class Filtros {
<#list (inputModel.fields)![] as f>
        <#if f.label?? && f.label?has_content>@Label("${f.label?j_string}") </#if>${javaType(f)} ${commandName(f)};
</#list>
    }

    private final ${ucClass}UseCase useCase;
    private final ObjectMapper objectMapper;
<#if template.item??>
    private final ${template.item.pageFqn} itemPage;
</#if>
<#if usecase.description?? && usecase.description?has_content>

    @Override
    protected String pageSubtitle() {
        return "${usecase.description?j_string}";
    }
</#if>

    @Override
    @SneakyThrows
    public ListingData<${template.rowClass}> search(SearchRequest request, HttpRequest httpRequest) {
        var filters = filters(request);
        if (filters == null) filters = new Filtros();
        var result = useCase.handle(new ${ucClass}Command(${commandArgs("filters.")}));
        var json = result.${template.itemsField}();
        List<${template.rowClass}> rows = json == null || json.isBlank() ? new ArrayList<>()
                : objectMapper.readValue(json, objectMapper.getTypeFactory().constructCollectionType(List.class, ${template.rowClass}.class));
        var text = request.searchText();
        if (text != null && !text.isBlank()) {
            var needle = text.toLowerCase();
            rows = rows.stream().filter(row -> (""<#list rowFields as f> + " " + row.get${f.name?cap_first}()</#list>)
                    .toLowerCase().contains(needle)).toList();
        }
        return ListingData.from(rows);
    }
<#if template.item??>

    @Override
    public ${template.item.pageFqn} view(String id, HttpRequest httpRequest) {
        return itemPage.load(id);
    }
</#if>
}
