<#include "common.ftl">
<#assign ucSlug = usecase.name?lower_case?replace("[^a-z0-9]","",'r')>
<#assign ucClass = usecase.className>
<#assign tf = template.fields>
package ${project.packageName}.${module.slug}.infra.in.ui.pages.${ucSlug};

import com.fasterxml.jackson.databind.ObjectMapper;
import io.mateu.core.infra.declarative.orchestrators.calendar.CalendarPage;
import io.mateu.uidl.annotations.Title;
import io.mateu.uidl.data.CalendarEvent;
import io.mateu.uidl.interfaces.HttpRequest;
import ${project.packageName}.${module.slug}.application.usecases.${ucSlug}.${ucClass}Command;
import ${project.packageName}.${module.slug}.application.usecases.${ucSlug}.${ucClass}UseCase;
import java.time.LocalDate;
import java.util.ArrayList;
import java.util.List;
import lombok.RequiredArgsConstructor;
import lombok.SneakyThrows;
import org.springframework.context.annotation.Scope;
import org.springframework.stereotype.Service;

/**
 * ${usecase.title!ucClass}: Mateu's calendar template — each of the use case's ${template.itemsField} is
 * an event on its ${tf.date!"date"}<#if template.item??>; clicking one opens ${template.item.className}</#if>.
 * Generated by modux from the use case's pageTemplate.
 */
@Service
@Scope("prototype")
@RequiredArgsConstructor
@Title("${(usecase.title!ucClass)?j_string}")
public class ${ucClass}Page extends CalendarPage {

    private final ${ucClass}UseCase useCase;
    private final ObjectMapper objectMapper;
<#if template.item??>
    private final ${template.item.pageFqn} itemPage;
</#if>

    @SneakyThrows
    private List<${template.rowClass}> rows() {
        var result = useCase.handle(new ${ucClass}Command(${commandArgs("-")}));
        var json = result.${template.itemsField}();
        if (json == null || json.isBlank()) return new ArrayList<>();
        return objectMapper.readValue(json,
                objectMapper.getTypeFactory().constructCollectionType(List.class, ${template.rowClass}.class));
    }

    private static LocalDate dateOf(Object value) {
        if (value == null || String.valueOf(value).isBlank()) return null;
        return value instanceof LocalDate date ? date : LocalDate.parse(String.valueOf(value).substring(0, 10));
    }

    @Override
    protected List<CalendarEvent> events(LocalDate month, HttpRequest httpRequest) {
        var events = new ArrayList<CalendarEvent>();
        for (var row : rows()) {
            var date = dateOf(row.get${(tf.date!"date")?cap_first}());
            if (date == null) continue;
<#if tf.endDate??>
            var end = dateOf(row.get${tf.endDate?cap_first}());
<#else>
            LocalDate end = null;
</#if>
            var last = end != null ? end : date;
            if (last.isBefore(month.withDayOfMonth(1)) || date.isAfter(month.withDayOfMonth(month.lengthOfMonth()))) continue;
            events.add(CalendarEvent.builder()
                    .id(${rowText(tf.id!"id")})
                    .title(${rowText(tf.title!"title")})
                    .date(date)
                    .endDate(end)
                    .build());
        }
        return events;
    }

    @Override
    protected Object actionOn(CalendarEvent event, HttpRequest httpRequest) {
<#if template.item??>
        return itemPage.load(event.id());
<#else>
        return null;
</#if>
    }
}
