<#include "common.ftl">
<#include "markdown-table.ftl">
<#assign ucSlug = usecase.name?lower_case?replace("[^a-z0-9]","",'r')>
<#assign ucClass = usecase.className>
<#assign tf = template.fields>
<#assign outFields = (outputModel.fields)![]>
<#function rendered f><#return (f.stereotype!"") == "html" || (f.stereotype!"") == "richText" || (f.stereotype!"") == "markdown"></#function>
<#function isList f><#return !(f.basicType?? && f.basicType) && (f.type!"") == "array" && f.modelId?? && template.rowModels[f.modelId]??></#function>
package ${project.packageName}.${module.slug}.infra.in.ui.pages.${ucSlug};

import com.fasterxml.jackson.databind.ObjectMapper;
import io.mateu.core.infra.declarative.orchestrators.itemoverview.ItemOverview;
import io.mateu.uidl.annotations.Panel;
import io.mateu.uidl.annotations.Title;
import io.mateu.uidl.data.Element;
import io.mateu.uidl.data.Markdown;
import io.mateu.uidl.fluent.Component;
import io.mateu.uidl.interfaces.DetailContentSupplier;
import io.mateu.uidl.interfaces.HttpRequest;
import ${project.packageName}.${module.slug}.application.usecases.${ucSlug}.${ucClass}Command;
import ${project.packageName}.${module.slug}.application.usecases.${ucSlug}.${ucClass}Result;
import ${project.packageName}.${module.slug}.application.usecases.${ucSlug}.${ucClass}UseCase;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import lombok.SneakyThrows;
import org.springframework.context.annotation.Scope;
import org.springframework.stereotype.Service;

/**
 * ${usecase.title!ucClass}: Mateu's item overview template — the key information of one item on
 * top and a tab for each of its contents and lists. It opens with the item's
 * <#list (inputModel.fields)![] as f>${commandName(f)}<#sep>, </#sep></#list> (from the URL, or {@link #load} when another page opens it).
 * Generated by modux from the use case's pageTemplate.
 */
@Service
@Scope("prototype")
@Title("${(usecase.title!ucClass)?j_string}")
public class ${ucClass}Page extends ItemOverview implements DetailContentSupplier {

<#list (inputModel.fields)![] as f>
    /** Bound from the URL (?${commandName(f)}=…). */
    ${javaType(f)} ${commandName(f)};
</#list>

    /** The key information: the item's title and its plain values. */
    Markdown keyInfo;
<#list outFields as f>
<#if rendered(f)>

    @Panel(title = "${((f.label?? && f.label?has_content)?then(f.label, f.name?cap_first))?j_string}")
    Component ${f.name}Panel;
<#elseif isList(f)>

    @Panel(title = "${((f.label?? && f.label?has_content)?then(f.label, f.name?cap_first))?j_string}")
    Markdown ${f.name}Panel;
</#if>
</#list>

    private final transient ${ucClass}UseCase useCase;
    private final transient ObjectMapper objectMapper;
    private transient boolean loaded;

    public ${ucClass}Page(${ucClass}UseCase useCase, ObjectMapper objectMapper) {
        this.useCase = useCase;
        this.objectMapper = objectMapper;
    }

<#if (inputModel.fields)?? && inputModel.fields?size == 1>
    /** This item's page: what a list or a calendar opens when one of its items is clicked. */
    public ${ucClass}Page load(String id) {
<#assign only = inputModel.fields[0]>
<#assign ot = javaType(only)>
        this.${commandName(only)} = <#if ot == "String">id<#elseif ot == "Integer">Integer.valueOf(id)<#elseif ot == "Long">Long.valueOf(id)<#else>${ot}.valueOf(id)</#if>;
        return load();
    }

</#if>
    @SneakyThrows
    public ${ucClass}Page load() {
        ${ucClass}Result result = useCase.handle(new ${ucClass}Command(${commandArgs("this.")}));
        var key = new StringBuilder();
<#if tf.title??>
        key.append("### ").append(result.${tf.title}() != null ? result.${tf.title}() : "").append("\n\n");
</#if>
<#list outFields as f>
<#if !rendered(f) && !isList(f) && (tf.title!"") != f.name && (f.basicType?? && f.basicType || (f.enumId?? && f.enumId?has_content))>
        if (result.${f.name}() != null && !String.valueOf(result.${f.name}()).isBlank()) {
            key.append("- **${((f.label?? && f.label?has_content)?then(f.label, f.name?cap_first))?j_string}:** ").append(result.${f.name}()).append("\n");
        }
</#if>
</#list>
        keyInfo = new Markdown(key.toString(), null, null);
<#list outFields as f>
<#if rendered(f)>
<#if f.stereotype == "markdown">
        ${f.name}Panel = new Markdown(result.${f.name}() != null ? result.${f.name}() : "", null, null);
<#else>
        ${f.name}Panel = Element.builder().name("div").attributes(Map.of()).on(Map.of())
                .content(result.${f.name}() != null ? result.${f.name}() : "").style("").cssClasses("").html(true).build();
</#if>
<#elseif isList(f)>
        ${f.name}Panel = new Markdown(tableOf(objectMapper, result.${f.name}(), ${columnsOf(template.rowModels[f.modelId])}), null, null);
</#if>
</#list>
        loaded = true;
        return this;
    }

    @Override
    public Component component(HttpRequest httpRequest) {
        if (!loaded) load();
        return super.component(httpRequest);
    }

    /**
     * What a list's row shows when it opens this item (a smart search's Navigable view): the same
     * overview, not Mateu's default read-only form of this class's fields.
     */
    @Override
    public Component detailContent(HttpRequest httpRequest) {
        return component(httpRequest);
    }

<@markdownTableHelper/>
}
