<#include "common.ftl">
<#assign ucSlug = usecase.name?lower_case?replace("[^a-z0-9]","",'r')>
<#assign ucClass = usecase.className>
<#assign tf = template.fields>
package ${project.packageName}.${module.slug}.infra.in.ui.pages.${ucSlug};

import com.fasterxml.jackson.databind.ObjectMapper;
import io.mateu.core.infra.declarative.orchestrators.todolist.TodoList;
import io.mateu.uidl.annotations.Title;
import io.mateu.uidl.interfaces.HttpRequest;
import ${project.packageName}.${module.slug}.application.usecases.${ucSlug}.${ucClass}Command;
import ${project.packageName}.${module.slug}.application.usecases.${ucSlug}.${ucClass}UseCase;
import java.util.ArrayList;
import java.util.List;
import lombok.RequiredArgsConstructor;
import lombok.SneakyThrows;
import org.springframework.context.annotation.Scope;
import org.springframework.stereotype.Service;

/**
 * ${usecase.title!ucClass}: Mateu's to-do list template — the use case's ${template.itemsField} as
 * cards grouped by ${tf.group!"(none)"}<#if template.item??>; clicking one opens ${template.item.className}</#if>.
 * Generated by modux from the use case's pageTemplate.
 */
@Service
@Scope("prototype")
@RequiredArgsConstructor
@Title("${(usecase.title!ucClass)?j_string}")
public class ${ucClass}Page extends TodoList<${template.rowClass}> {

    private final ${ucClass}UseCase useCase;
    private final ObjectMapper objectMapper;
<#if template.item??>
    private final ${template.item.pageFqn} itemPage;
</#if>

    @Override
    @SneakyThrows
    protected List<${template.rowClass}> rows(HttpRequest httpRequest) {
        var result = useCase.handle(new ${ucClass}Command(${commandArgs("-")}));
        var json = result.${template.itemsField}();
        if (json == null || json.isBlank()) return new ArrayList<>();
        return objectMapper.readValue(json,
                objectMapper.getTypeFactory().constructCollectionType(List.class, ${template.rowClass}.class));
    }

    @Override
    protected String idOf(${template.rowClass} row) {
        return ${rowText(tf.id!"id")};
    }

    @Override
    protected String titleOf(${template.rowClass} row) {
        return ${rowText(tf.title!"title")};
    }

    @Override
    protected String groupOf(${template.rowClass} row) {
        return ${rowText(tf.group!"group")};
    }
<#if tf.caption??>

    @Override
    protected String captionOf(${template.rowClass} row) {
        return ${rowText(tf.caption)};
    }
</#if>

    @Override
    protected Object actionOn(${template.rowClass} row, HttpRequest httpRequest) {
<#if template.item??>
        return itemPage.load(idOf(row));
<#else>
        return null;
</#if>
    }
}
