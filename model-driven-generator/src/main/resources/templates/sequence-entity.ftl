<#assign slug = module.name?lower_case?replace("[^a-z0-9]","",'r')>
package ${project.packageName}.${slug}.infra.out.persistence;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.Id;
import jakarta.persistence.Table;
import lombok.Getter;
import lombok.NoArgsConstructor;
import lombok.Setter;

/** One correlative series: its name and the last number given. Generated by modux. */
@Entity(name = "${slug?cap_first}Sequence")
@Table(name = "${slug}_sequence")
@Getter
@Setter
@NoArgsConstructor
public class ${slug?cap_first}SequenceEntity {

    @Id
    @Column(name = "name")
    String name;

    @Column(name = "last_value")
    Long lastValue;
}
