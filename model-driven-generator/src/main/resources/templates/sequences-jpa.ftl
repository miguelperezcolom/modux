<#assign slug = module.name?lower_case?replace("[^a-z0-9]","",'r')>
package ${project.packageName}.${slug}.infra.out.persistence;

import ${project.packageName}.${slug}.application.out.Sequences;
import org.springframework.stereotype.Component;
import org.springframework.transaction.annotation.Propagation;
import org.springframework.transaction.annotation.Transactional;

/** {@link Sequences} over a table (one row per series), locked while a number is taken. Generated by modux. */
@Component("${slug}Sequences")
public class ${slug?cap_first}JpaSequences implements Sequences {

    private final ${slug?cap_first}SequenceRepository repository;

    public ${slug?cap_first}JpaSequences(${slug?cap_first}SequenceRepository repository) {
        this.repository = repository;
    }

    @Override
    @Transactional(propagation = Propagation.MANDATORY)
    public long next(String name) {
        var sequence = repository.lockByName(name).orElseGet(() -> {
            var created = new ${slug?cap_first}SequenceEntity();
            created.setName(name);
            created.setLastValue(0L);
            return repository.saveAndFlush(created);
        });
        sequence.setLastValue(sequence.getLastValue() + 1);
        repository.save(sequence);
        return sequence.getLastValue();
    }
}
