<#assign localIdp = idp?? && idp.url?contains("localhost")>
<#assign uiEs = ((project.defaultLocale!"")?has_content?then(project.defaultLocale!"", (project.locales![])?has_content?then((project.locales![""])[0], "")))?lower_case?starts_with("es")>
#!/bin/sh
# ${project.name} — down.sh (<#if uiEs>GENERADO por modux; se regenera con el modelo<#else>GENERATED by modux; regenerated with the model</#if>)
set -e

PRE="${project.name?lower_case?replace("[^a-z0-9]","-",'r')}"

<#list services as s>
pkill -f "${s.name}-app-0.0.1-SNAPSHOT.jar" 2>/dev/null || true
</#list>
<#list shells as sh>
pkill -f "${sh.slug}-0.0.1-SNAPSHOT.jar" 2>/dev/null || true
</#list>
<#if shells?has_content>
pkill -f "api-gateway-1.0.0.jar" 2>/dev/null || true
</#if>
docker rm -f $PRE-postgres $PRE-kafka <#if localIdp>$PRE-keycloak </#if>>/dev/null 2>&1 || true

echo "<#if uiEs>Sistema parado (los logs quedan en .up-*.log).<#else>System stopped (the logs stay in .up-*.log).</#if>"
