package ${project.packageName}.${module.slug}.infra.in.async;

import com.fasterxml.jackson.databind.ObjectMapper;
import ${project.packageName}.${module.slug}.application.out.MailSender;
import java.util.ArrayList;
import java.util.Map;
import java.util.function.Consumer;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.core.env.Environment;
import org.springframework.messaging.Message;

/**
 * Notification «${notification.name}»: when ${notification.eventName} happens, an email
 * (subject and body from the model, {field} replaced by the event's value) to
<#if notification.recipientField??> the event's ${notification.recipientField}</#if><#if notification.roles?has_content><#if notification.recipientField??> and</#if> the people of <#list notification.roles as r>${r}<#sep>, </#sep></#list> (NOTIFY_<ROLE>: their emails, comma-separated)</#if>.
 * Generated by modux from the model's notifications.
 */
@Slf4j
// named apart from its function bean (${notification.function}), which has the class's own name
@Configuration("${notification.function}Configuration")
@RequiredArgsConstructor
public class ${notification.className} {

    private final MailSender mail;
    private final ObjectMapper objectMapper;
    private final Environment environment;

    static final String SUBJECT = "${(notification.subject!"")?j_string}";
    static final String BODY = "${(notification.body!"")?j_string}";

    @Bean
    public Consumer<Message<String>> ${notification.function}() {
        return message -> {
            try {
                @SuppressWarnings("unchecked")
                Map<String, Object> event = objectMapper.readValue(message.getPayload(), Map.class);
                var to = new ArrayList<String>();
<#if notification.recipientField??>
                if (event.get("${notification.recipientField}") != null) to.add(String.valueOf(event.get("${notification.recipientField}")));
</#if>
<#list notification.roles as r>
                for (var address : environment.getProperty("NOTIFY_${r?upper_case?replace("[^A-Z0-9]","_",'r')}", "").split(",")) {
                    if (!address.isBlank()) to.add(address.trim());
                }
</#list>
                for (var address : to) {
                    mail.send(address, fill(SUBJECT, event, false), fill(BODY, event, true));
                }
            } catch (Exception e) {
                // a failed send is retried by redelivering the event
                throw new IllegalStateException("Notification ${notification.name} could not be sent", e);
            }
        };
    }

    /** The template with every {field} replaced by the event's value (escaped in the HTML body). */
    static String fill(String template, Map<String, Object> event, boolean html) {
        var out = template;
        for (var entry : event.entrySet()) {
            var value = entry.getValue() == null ? "" : String.valueOf(entry.getValue());
            if (html) value = value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;");
            out = out.replace("{" + entry.getKey() + "}", value);
        }
        return out;
    }
}
