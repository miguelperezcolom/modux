package ${project.packageName}.${module.name?lower_case?replace("[^a-z0-9]","",'r')}.application.out;

import java.util.Set;

/**
 * Who is running the current use case: the person signed in (through the identity provider or the
 * system's login) or the calling service. What business rules about people need — «whoever asked for
 * it cannot approve it», «recorded by», «my preferences» — without knowing how they signed in.
 * Generated by modux.
 */
public interface CurrentUser {

    /** The signed-in user's name (the identity provider's preferred_username), or null when nobody is. */
    String username();

    /** The user's roles, without the ROLE_ prefix (e.g. EDITOR). Empty when nobody is signed in. */
    Set<String> roles();

    /** Whether someone is signed in. */
    default boolean authenticated() {
        return username() != null;
    }

    /** Whether the user has that role (with or without the ROLE_ prefix). */
    default boolean hasRole(String role) {
        return role != null && roles().contains(role.startsWith("ROLE_") ? role.substring(5) : role);
    }
}
