# ${project.name} on Kubernetes, namespace ${namespace}. GENERATED by modux from the model's
# deployment environment; `mvn modux:deploy -Dmodux.env=<env>` builds the images, fills in their
# tag (__TAG__) and applies it. The database password lives in the Secret ${projectSlug}-db, which
# the deploy creates once with a random value: it is never in this file.
apiVersion: v1
kind: Namespace
metadata:
  name: ${namespace}
<#if databases?has_content>
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: postgres-init
  namespace: ${namespace}
data:
  # one database per service, created on the first boot of the volume
  init.sql: |
<#list databases as db>
    CREATE DATABASE "${db}";
</#list>
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: postgres
  namespace: ${namespace}
spec:
  serviceName: postgres
  replicas: 1
  selector:
    matchLabels: {app: postgres}
  template:
    metadata:
      labels: {app: postgres}
    spec:
      containers:
        - name: postgres
          image: postgres:16-alpine
          env:
            - {name: POSTGRES_USER, value: user_app}
            - name: POSTGRES_PASSWORD
              valueFrom: {secretKeyRef: {name: ${projectSlug}-db, key: password}}
            - {name: PGDATA, value: /var/lib/postgresql/data/pgdata}
          ports: [{containerPort: 5432}]
          readinessProbe:
            exec: {command: ["pg_isready", "-U", "user_app"]}
            periodSeconds: 5
          resources:
            requests: {cpu: 50m, memory: 128Mi}
            limits: {memory: 512Mi}
          volumeMounts:
            - {name: data, mountPath: /var/lib/postgresql/data}
            - {name: init, mountPath: /docker-entrypoint-initdb.d}
      volumes:
        - name: init
          configMap: {name: postgres-init}
  volumeClaimTemplates:
    - metadata: {name: data}
      spec:
        accessModes: [ReadWriteOnce]
        resources: {requests: {storage: 10Gi}}
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: ${namespace}
spec:
  selector: {app: postgres}
  ports: [{port: 5432}]
---
# single-node Kafka (KRaft): enough for one environment; its log lives in the pod
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: kafka
  namespace: ${namespace}
spec:
  serviceName: kafka
  replicas: 1
  selector:
    matchLabels: {app: kafka}
  template:
    metadata:
      labels: {app: kafka}
    spec:
      enableServiceLinks: false
      containers:
        - name: kafka
          image: apache/kafka:3.8.0
          env:
            - {name: KAFKA_NODE_ID, value: "1"}
            - {name: KAFKA_PROCESS_ROLES, value: "broker,controller"}
            - {name: KAFKA_LISTENERS, value: "PLAINTEXT://:9092,CONTROLLER://:9093"}
            - {name: KAFKA_ADVERTISED_LISTENERS, value: "PLAINTEXT://kafka:9092"}
            - {name: KAFKA_CONTROLLER_LISTENER_NAMES, value: CONTROLLER}
            - {name: KAFKA_LISTENER_SECURITY_PROTOCOL_MAP, value: "CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT"}
            - {name: KAFKA_CONTROLLER_QUORUM_VOTERS, value: "1@localhost:9093"}
            - {name: KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR, value: "1"}
            - {name: KAFKA_HEAP_OPTS, value: "-Xms256m -Xmx384m"}
          ports: [{containerPort: 9092}]
          readinessProbe:
            tcpSocket: {port: 9092}
            periodSeconds: 5
          resources:
            requests: {cpu: 100m, memory: 512Mi}
            limits: {memory: 768Mi}
---
apiVersion: v1
kind: Service
metadata:
  name: kafka
  namespace: ${namespace}
spec:
  selector: {app: kafka}
  ports: [{port: 9092}]
</#if>
<#list runnables as r>
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${r.name}
  namespace: ${namespace}
  labels: {app: ${r.name}}
spec:
  replicas: 1
  selector:
    matchLabels: {app: ${r.name}}
  template:
    metadata:
      labels: {app: ${r.name}}
    spec:
      enableServiceLinks: false
<#if r.kind == "service" && databases?has_content>
      # start once the database and the broker answer, instead of crashing until they do
      initContainers:
        - name: wait-for-infra
          image: busybox:1.36
          command: ["sh", "-c", "until nc -z postgres 5432 && nc -z kafka 9092; do sleep 2; done"]
</#if>
      containers:
        - name: ${r.name}
          image: ${r.image}:__TAG__
          imagePullPolicy: IfNotPresent
          env:
            - {name: JAVA_OPTS, value: "-XX:MaxRAMPercentage=70"}
<#if r.kind == "service" || r.kind == "shell">
            # signs the system's single login when there is no identity provider (ModuxAuthCookie)
            - name: MODUX_AUTH_SECRET
              valueFrom: {secretKeyRef: {name: ${projectSlug}-db, key: auth, optional: true}}
</#if>
<#if r.kind == "service">
            - {name: SPRING_DATASOURCE_URL, value: "jdbc:postgresql://postgres:5432/${r.db}"}
            - {name: SPRING_DATASOURCE_USERNAME, value: user_app}
            - name: SPRING_DATASOURCE_PASSWORD
              valueFrom: {secretKeyRef: {name: ${projectSlug}-db, key: password}}
            - {name: SPRING_KAFKA_BOOTSTRAP_SERVERS, value: "kafka:9092"}
<#list (r.gatewayEnvs![]) as ge>
            - {name: ${ge.envName}, value: "${ge.url?lower_case}"}
</#list>
<#list runnables?filter(x -> x.kind == "service" && x.name != r.name) as s>
            - {name: ${s.name?upper_case?replace("-","_")}_URL, value: "http://${s.name}:${s.port?c}"}
</#list>
<#list (externalUrls![]) as x>
            - {name: ${x.envName}, value: "${x.url}"}
</#list>
<#list (externalJdbcEnvs![]) as j>
            # a legacy table a projection polls: kubectl create secret generic ${projectSlug}-external --from-literal=${j?lower_case?replace("_","-")}=…
            - name: ${j}
              valueFrom: {secretKeyRef: {name: ${projectSlug}-external, key: ${j?lower_case?replace("_","-")}, optional: true}}
</#list>
<#elseif r.kind == "gateway">
<#list runnables?filter(x -> x.kind == "service") as s>
            - {name: ${s.name?upper_case?replace("-","_")}_URL, value: "http://${s.name}:${s.port?c}"}
</#list>
<#list runnables?filter(x -> x.kind == "shell") as s>
            - {name: SHELL_URL, value: "http://${s.name}:${s.port?c}"}
</#list>
<#elseif r.kind == "shell">
            # the shell asks the remote apps for their menus through the gateway
            - {name: MATEU_SELF_BASE_URL, value: "http://gateway:8088"}
<#assign frontHosts = (runnables?filter(x -> x.kind == "gateway")?first.hosts)![]>
<#if frontHosts?has_content>
            # where people enter: the identity provider sends them back here after signing in
            - {name: MODUX_PUBLIC_URL, value: "<#if tls>https<#else>http</#if>://${frontHosts?first}"}
</#if>
</#if>
          ports: [{containerPort: ${r.port?c}}]
          startupProbe:
            tcpSocket: {port: ${r.port?c}}
            periodSeconds: 5
            failureThreshold: 60
          readinessProbe:
            tcpSocket: {port: ${r.port?c}}
            periodSeconds: 10
          livenessProbe:
            tcpSocket: {port: ${r.port?c}}
            periodSeconds: 20
            failureThreshold: 6
          resources:
            requests: {cpu: 100m, memory: 448Mi}
            limits: {memory: 1Gi}
---
apiVersion: v1
kind: Service
metadata:
  name: ${r.name}
  namespace: ${namespace}
spec:
  selector: {app: ${r.name}}
  ports: [{port: ${r.port?c}}]
<#if r.hosts?has_content>
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ${r.name}
  namespace: ${namespace}
  annotations:
<#if certIssuer??>
    cert-manager.io/cluster-issuer: ${certIssuer}
</#if>
<#if ingressClass == "nginx">
    # Mateu keeps long-lived requests open: no buffering, generous timeouts
    nginx.ingress.kubernetes.io/proxy-buffering: "off"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
    nginx.ingress.kubernetes.io/proxy-body-size: "50m"
</#if>
spec:
  ingressClassName: ${ingressClass}
<#if tls>
  tls:
    - hosts: [<#list r.hosts as h>"${h}"<#sep>, </#sep></#list>]
      secretName: ${r.name}-tls
</#if>
  rules:
<#list r.hosts as h>
    - host: ${h}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: ${r.name}
                port: {number: ${r.port?c}}
</#list>
</#if>
</#list>
