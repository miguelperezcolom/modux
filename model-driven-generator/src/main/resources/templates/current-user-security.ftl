package ${project.packageName}.${module.name?lower_case?replace("[^a-z0-9]","",'r')}.infra.out.security;

import ${project.packageName}.${module.name?lower_case?replace("[^a-z0-9]","",'r')}.application.out.CurrentUser;
import java.util.Set;
import java.util.stream.Collectors;
import org.springframework.security.authentication.AnonymousAuthenticationToken;
import org.springframework.security.core.GrantedAuthority;
import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.stereotype.Component;

/** {@link CurrentUser} from Spring Security's context (the system's cookie, the IdP's JWT or basic). Generated by modux. */
@Component("${module.name?lower_case?replace("[^a-z0-9]","",'r')}CurrentUser")
public class SpringSecurityCurrentUser implements CurrentUser {

    @Override
    public String username() {
        var auth = SecurityContextHolder.getContext().getAuthentication();
        if (auth == null || !auth.isAuthenticated() || auth instanceof AnonymousAuthenticationToken) return null;
        return auth.getName();
    }

    @Override
    public Set<String> roles() {
        var auth = SecurityContextHolder.getContext().getAuthentication();
        if (auth == null || auth instanceof AnonymousAuthenticationToken) return Set.of();
        return auth.getAuthorities().stream().map(GrantedAuthority::getAuthority)
                .map(a -> a.startsWith("ROLE_") ? a.substring(5) : a).collect(Collectors.toUnmodifiableSet());
    }
}
