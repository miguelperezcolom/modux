package ${project.packageName}.${module.name?lower_case?replace("[^a-z0-9]","",'r')}.application.out;

/**
 * Correlative numbers kept by the system (an issue number, an invoice series): each name counts on
 * its own, from 1, without gaps — the number is taken inside the use case's transaction, so a use
 * case that fails gives it back. Generated by modux (fields with systemValue SEQUENCE).
 */
public interface Sequences {

    /** The next number of the {@code name} series (1 the first time). */
    long next(String name);
}
